{
  "displayName": "Mitsubishi AC AU/NZ",
  "name": "homebridge-mitsubishi-ac-au-nz",
  "version": "1.3.0",
  "description": "Control your Mitsubishi Aircon units with Homebridge and Apple HomeKit",
  "license": "Apache-2.0",
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.com/paypalme/aureliocalegari"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnwatso/homebridge-mitsubishi-ac-au-nz.git"
  },
  "bugs": {
    "url": "https://github.com/johnwatso/homebridge-mitsubishi-ac-au-nz/issues"
  },
  "engines": {
    "node": "^22 || ^24",
    "homebridge": ">=2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "docs",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "tough-cookie": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.21",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^10.8.1",
    "homebridge": "^2.1.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
